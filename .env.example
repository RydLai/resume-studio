# Copy to .env and fill in your own values. Never commit .env.
PORT=3001
HOST=127.0.0.1

# MySQL database and application account (not root).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=resume_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=resume_studio

# Signs the login session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=replace-with-a-long-random-secret

# Default users, created only when the username does not exist.
# Format: username:password,username:password
# Registration is intentionally disabled.
SEED_USERS=admin:replace-with-a-strong-password

# Optional: import an existing Markdown file as the first resume for a seeded user.
# The file must be a .md file in the project root. It is only used when that user
# has no resume row yet. Keep personal files out of the public repository.
SEED_RESUME_USER=admin
SEED_RESUME_FILE=resume.md

# Set to 1 when Express runs behind a trusted HTTPS reverse proxy.
# TRUST_PROXY=1
