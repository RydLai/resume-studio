# Copy to .env and set your own values. Never commit .env.
PORT=3001
HOST=127.0.0.1

# Required: password for generating/downloading PDF. Export is disabled if empty.
PDF_EXPORT_PASSWORD=replace-with-your-export-password

# Recommended: random string used to sign the 2-hour export session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPORT_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: protect the entire site with HTTP Basic Auth.
# Set both to enable. Use HTTPS when enabled.
# APP_ACCESS_USER=resume
# APP_ACCESS_PASSWORD=replace-with-a-strong-site-password

# Optional: Chromium needs --no-sandbox when running as root in a container/VPS.
# CHROME_NO_SANDBOX=1

# Optional: set to 1 if Express runs behind a trusted reverse proxy.
# TRUST_PROXY=1
